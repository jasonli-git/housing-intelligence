{
  "name": "hip-web",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "routes:refresh": "node scripts/refresh-place-routes.mjs",
    "dev": "next dev -p 3000",
    "build": "next build && node scripts/write-place-aliases.mjs",
    "start": "next start -p 3000",
    "screenshot:poc": "node scripts/capture-screenshot.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:a11y": "node scripts/check-accessibility.mjs",
    "check:a11y:interactions": "node scripts/check-accessibility-interactions.mjs",
    "check:ui-refinement": "node scripts/check-ui-refinement.mjs",
    "check:a11y:serve": "node scripts/serve-accessibility.mjs"
  },
  "dependencies": {
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "jsdom": "^30.1.2",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
