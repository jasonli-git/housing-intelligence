# Copy to .env and fill in. .env is gitignored; never commit real keys.
# Every HIP_ variable has a working default — only the API keys genuinely block work,
# and only from Milestone 3 onward.

# --- Database (matches docker-compose.yml) ---
HIP_DATABASE_URL=postgresql+psycopg://hip:hip@localhost:5432/hip

# Postgres container credentials. Change POSTGRES_PORT if 5432 is already taken on
# this machine, and change HIP_DATABASE_URL to match.
POSTGRES_USER=hip
POSTGRES_PASSWORD=hip
POSTGRES_DB=hip
POSTGRES_PORT=5432

# --- Paths (defaults are repo-relative; override only for external storage) ---
# Absolute paths are recommended; `~` is expanded. Every stage creates what it needs,
# so pointing these somewhere new needs no mkdir first — but nothing is *moved* either,
# and a fresh location starts empty. `make data-dirs` shows where they currently point.
#
# HIP_DATA_DIR is the three rebuildable storage tiers: raw, parquet, duckdb, packets.
# HIP_DATA_DIR=data
# HIP_CONFIG_DIR=config
#
# HIP_REPORTS_DIR is human-facing output, and is deliberately NOT under HIP_DATA_DIR:
# it holds the 21 git-tracked county reports and the evaluation report, both linked
# from the README. Until 2026-09-01 it was derived from HIP_DATA_DIR's parent, so
# moving the data root moved these off the repo with it.
# HIP_REPORTS_DIR=reports
#
# HIP_PGDATA relocates the Postgres data directory, read by docker-compose.yml rather
# than by the application. Unset it and Compose uses the `pgdata` named volume, which
# is where any warehouse you have already loaded lives. Setting it to a path points
# Postgres at that directory instead — it does not migrate anything, and an empty
# directory initialises a brand new cluster that `make migrate` must then populate.
# HIP_PGDATA=/Volumes/YourSSD/hip-pgdata

# --- Source API keys ---
# Required from Milestone 3. Free, both need only an email address.
# https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=
# https://fredaccount.stlouisfed.org/apikeys — no anonymous access at all
FRED_API_KEY=
# https://data.bls.gov/registrationEngine/ — optional; anonymous is 25 queries/day
BLS_API_KEY=

# --- Evaluation (Milestone 8) ---
# Grades local-model answers against the rubric. The only paid key the platform uses:
# roughly $0.018 per judgment through the Batch API. Nothing outside `hip eval judge`
# reads it, and every other stage runs without it.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
