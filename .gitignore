# Data tiers — machine-local, rebuildable, never committed (ARCHITECTURE #10)
data/

# reports/ is machine-local output too, with one published exception: the
# model-evaluation report, small Markdown linked from the README and rebuilt by
# `hip eval report`. The county reports `hip pack --report` writes are not kept: the
# site publishes them fresh with each deploy (ARCHITECTURE #418). Validation-gate JSON stays out: it is per-run
# machine state, not a document anyone reads. The completeness runs are the third
# exception and the one that is not rebuildable: each records the warehouse as it stood
# that day, and the next run is compared with it (ROADMAP, the completeness check).
# The commercial viability study (Milestone 32) is the fourth: a document read for a
# decision, not output any command rebuilds.
reports/**
!reports/evaluation/
!reports/evaluation/*.md
!reports/completeness/
!reports/completeness/*.md
!reports/commercial/
!reports/commercial/*.md

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# DuckDB
*.duckdb
*.duckdb.wal

# dbt
dbt/target/
dbt/dbt_packages/
dbt/logs/
.user.yml

# Node / Next.js
node_modules/
web/.next/
web/out/
web/.property-scale.json
web/next-env.d.ts
# Incremental typecheck cache: rewritten by every `tsc`, so tracking it turns any
# typecheck into a dirty working tree.
*.tsbuildinfo

# Secrets and local overrides
.env
.env.local
*.local

# Deployable output from `make publish`: two trees for two hosts, both rebuildable.
dist/
web/.publication/
web/.wrangler/

# The scheduled refresh's own output (Milestone 27) — machine-local, and the reason it
# exists is so a failure has somewhere to be read from after the Pushover notification
# already said something went wrong.
logs/

# OS
.DS_Store

# Claude desktop preview config (per machine)
.claude/launch.json

# Claude local permission grants (per machine)
.claude/settings.local.json

# Wrangler's local cache: the Cloudflare account it last used. Never tracked.
.wrangler/
