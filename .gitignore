# Data tiers — machine-local, rebuildable, never committed (ARCHITECTURE #10)
data/

# reports/ is machine-local output too, with two published exceptions: the 21 county
# region reports and the model-evaluation report. Both are small Markdown, both are
# linked from the README, and both stay rebuildable — `hip pack --report` and
# `hip eval report` overwrite them. Validation-gate JSON stays out: it is per-run
# machine state, not a document anyone reads.
reports/**
!reports/regions/
!reports/regions/5y/
!reports/regions/5y/*.md
!reports/evaluation/
!reports/evaluation/*.md

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# DuckDB
*.duckdb
*.duckdb.wal

# dbt
dbt/target/
dbt/dbt_packages/
dbt/logs/
.user.yml

# Node / Next.js
node_modules/
web/.next/
web/out/
web/next-env.d.ts
# Incremental typecheck cache: rewritten by every `tsc`, so tracking it turns any
# typecheck into a dirty working tree.
*.tsbuildinfo

# Secrets and local overrides
.env
.env.local
*.local

# OS
.DS_Store
